{
  "name": "paper-theater-card-crawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "legacy:dev": "node tools/serve-static.mjs",
    "legacy:build": "node tools/build-static.mjs",
    "legacy:preview": "node tools/serve-static.mjs dist",
    "data:generate:cards": "node tools/generate-full-card-data.mjs",
    "data:generate:content": "node tools/generate-full-content-data.mjs",
    "data:validate": "node tools/validate-data.mjs",
    "cards:curate:release-batch": "node tools/curate-card-release-batch.mjs",
    "cards:release:audit": "node tools/card-release-audit.mjs",
    "cards:audit": "node tools/card-balance-audit.mjs",
    "gems:curate:release-batch": "node tools/curate-gem-release-batch.mjs",
    "gems:release:audit": "node tools/gem-release-audit.mjs",
    "gems:audit": "node tools/gem-audit.mjs",
    "enemies:curate:release-batch": "node tools/curate-enemy-release-batch.mjs",
    "enemies:curate:release-batch-2": "node tools/curate-enemy-release-batch-2.mjs",
    "enemies:release:audit": "node tools/enemy-release-audit.mjs",
    "stages:curate:release-batch": "node tools/curate-stage-release-batch.mjs",
    "stages:release:audit": "node tools/stage-release-audit.mjs",
    "events:curate:release-batch": "node tools/curate-event-release-batch.mjs",
    "events:release:audit": "node tools/event-release-audit.mjs",
    "achievements:curate:release-batch": "node tools/curate-achievement-release-batch.mjs",
    "achievements:release:audit": "node tools/achievement-release-audit.mjs",
    "builds:audit": "node tools/build-item-audit.mjs",
    "events:audit": "node tools/event-audit.mjs",
    "rewards:audit": "node tools/reward-flow-audit.mjs",
    "quality:audit": "node tools/content-quality-audit.mjs",
    "quality:audit:report": "node tools/content-quality-audit.mjs --report-only",
    "slice:validate": "node tools/validate-slice-fixture.mjs",
    "slice:effects": "node tools/audit-slice-effects.mjs",
    "assets:generate:dev": "node tools/generate-dev-runtime-assets.mjs",
    "assets:generate:release-visuals": "node tools/generate-release-visual-assets.mjs",
    "assets:audit": "node tools/audit-asset-files.mjs",
    "assets:audit:strict": "node tools/audit-asset-files.mjs --require-files",
    "assets:audit:release-visuals": "node tools/visual-production-audit.mjs",
    "ui:pc-worldmap:keyboard": "node tools/ui-pc-worldmap-keyboard-audit.mjs",
    "ui:pc-worldmap:release-state": "node tools/ui-pc-worldmap-release-state-audit.mjs",
    "ui:pc-combat:affordance": "node tools/ui-pc-combat-affordance-audit.mjs",
    "phaser:smoke": "node tools/phaser-smoke-test.mjs",
    "proof:smoke": "node tools/vertical-slice-proof-smoke.mjs",
    "runtime:smoke": "node tools/runtime-smoke-test.mjs",
    "balance:simulate": "node tools/balance-simulation.mjs",
    "browser:smoke": "node tools/browser-smoke-test.mjs",
    "legacy:check": "node tools/validate-data.mjs && node tools/card-balance-audit.mjs && node tools/gem-audit.mjs && node tools/build-item-audit.mjs && node tools/event-audit.mjs && node tools/reward-flow-audit.mjs && node tools/runtime-smoke-test.mjs && node tools/build-static.mjs",
    "check": "npm run slice:validate && npm run slice:effects && npm run assets:audit && tsc --noEmit && vite build"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
